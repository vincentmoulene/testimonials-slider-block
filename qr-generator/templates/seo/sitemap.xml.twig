<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% for entry in entries %}
    <url>
        <loc>{{ entry.loc }}</loc>
        {% for locale, href in entry.alternates %}
        <xhtml:link rel="alternate" hreflang="{{ locale }}" href="{{ href }}"/>
        {% endfor %}
        {% if entry.alternates['en'] is defined %}
        <xhtml:link rel="alternate" hreflang="x-default" href="{{ entry.alternates['en'] }}"/>
        {% endif %}
        {% if entry.lastModified %}<lastmod>{{ entry.lastModified|date('Y-m-d') }}</lastmod>{% endif %}
        <changefreq>{{ entry.changeFrequency }}</changefreq>
        <priority>{{ entry.priority }}</priority>
    </url>
{% endfor %}
</urlset>
