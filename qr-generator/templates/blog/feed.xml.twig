<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ locale }}">
    <title>{{ site_name }} — {{ 'nav.blog'|trans({}, null, locale) }}</title>
    <link rel="alternate" type="text/html" href="{{ home_url }}"/>
    <link rel="self" type="application/atom+xml" href="{{ self_url }}"/>
    <id>{{ self_url }}</id>
    <updated>{{ articles is empty ? 'now'|date('c') : articles[0].updatedAt|date('c') }}</updated>
    {% for article in articles %}
        {% set url = site_url ~ path('app_article', {_locale: locale, slug: article.slug}) %}
        <entry>
            <title>{{ article.title }}</title>
            <link rel="alternate" type="text/html" href="{{ url }}"/>
            <id>{{ url }}</id>
            <published>{{ article.publishedAt|date('c') }}</published>
            <updated>{{ article.updatedAt|date('c') }}</updated>
            <summary>{{ article.description }}</summary>
        </entry>
    {% endfor %}
</feed>
