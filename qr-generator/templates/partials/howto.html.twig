<section class="howto wrap" id="how-to">
    <h2>{{ 'howto.title'|trans({'%tool%': tool_name}) }}</h2>
    <ol class="steps">
        {% for step in ['howto.step1', 'howto.step2', 'howto.step3'] %}
            <li>
                <span class="step-number" aria-hidden="true">{{ loop.index }}</span>
                <h3>{{ (step ~ '.title')|trans({'%tool%': tool_name}) }}</h3>
                <p>{{ (step ~ '.text')|trans({'%tool%': tool_name}) }}</p>
            </li>
        {% endfor %}
    </ol>
</section>
