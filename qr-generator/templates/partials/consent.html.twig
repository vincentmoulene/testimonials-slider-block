{% if adsense_enabled and adsense_client %}
    <div class="consent" data-consent-target="banner" role="dialog" aria-live="polite"
         aria-label="{{ 'consent.title'|trans }}" hidden>
        <div class="consent-inner">
            <div>
                <p class="consent-title">{{ 'consent.title'|trans }}</p>
                <p class="muted">
                    {{ 'consent.text'|trans }}
                    <a href="{{ path('app_cookies', {_locale: app.request.locale}) }}">{{ 'consent.learn_more'|trans }}</a>
                </p>
            </div>
            <div class="consent-actions">
                <button type="button" class="btn btn-ghost" data-action="consent#reject">{{ 'consent.reject'|trans }}</button>
                <button type="button" class="btn btn-primary" data-action="consent#accept">{{ 'consent.accept'|trans }}</button>
            </div>
        </div>
    </div>
{% endif %}
